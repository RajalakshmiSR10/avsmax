/* ==========================================
   HOLOGRAPHIC PLATFORM
   Rings moved UP toward the center
   ========================================== */

.holo-platform {
  position: absolute;
  left: 50%;
  bottom: 15%;
  width: min(48vw, 620px);
  aspect-ratio: 2.7 / 1;

  transform:
    translate3d(
      calc(-50% + var(--mouse-x) * -10px),
      calc(var(--mouse-y) * -5px),
      0
    );

  transform-style: preserve-3d;
}

/* Outer luminous ring */

.holo-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  transform-style: preserve-3d;
}

.holo-ring-outer {
  inset: 0;
  border: 1px solid rgba(65, 183, 255, 0.65);

  box-shadow:
    0 0 12px rgba(0, 170, 255, 0.25),
    inset 0 0 18px rgba(0, 170, 255, 0.1);

  animation: ringPulse 4s ease-in-out infinite;
}

/* Middle ring */

.holo-ring-middle {
  inset: 5%;
  border: 2px solid rgba(75, 214, 255, 0.88);

  box-shadow:
    0 0 12px rgba(0, 190, 255, 0.65),
    0 0 32px rgba(0, 145, 255, 0.32),
    inset 0 0 15px rgba(0, 180, 255, 0.22);

  animation: ringRotate 18s linear infinite;
}

/* Inner dashed ring */

.holo-ring-inner {
  inset: 13%;
  border: 1px dashed rgba(100, 214, 255, 0.78);

  animation: ringRotate 28s linear infinite reverse;
}

/* Central ring */

.holo-ring-core {
  inset: 26%;
  border: 2px solid rgba(112, 225, 255, 0.95);

  box-shadow:
    0 0 15px rgba(0, 190, 255, 0.55),
    inset 0 0 20px rgba(0, 160, 255, 0.22);
}

/* Core glow */

.holo-core-glow {
  position: absolute;
  inset: 23%;
  border-radius: 50%;

  background: radial-gradient(
    ellipse,
    rgba(0, 184, 255, 0.24),
    rgba(30, 53, 107, 0.1) 55%,
    transparent 75%
  );

  filter: blur(12px);
  animation: corePulse 3s ease-in-out infinite;
}

/* Circular platform marks */

.holo-ticks {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  animation: ringRotate 60s linear infinite;
}

.holo-ticks span {
  position: absolute;
  left: 50%;
  top: 1%;

  width: 2px;
  height: 7px;

  background: rgba(160, 231, 255, 0.85);
  box-shadow: 0 0 5px rgba(0, 180, 255, 0.7);

  transform:
    translateX(-50%)
    rotate(calc(var(--tick) * 5deg));

  transform-origin: 50% 700%;
}

/* ==========================================
   FLOATING FINANCE SYMBOLS
   ========================================== */

.avs3d-icon-layer {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
}

.finance-symbol {
  position: absolute;
  left: var(--x);
  top: var(--y);

  width: 1px;
  height: 1px;

  transform-style: preserve-3d;

  animation:
    symbolFloat
    calc(5s + var(--depth) * 1.5s)
    ease-in-out
    infinite;

  animation-delay: var(--delay);
}

/* Vertical light trail */

.symbol-beam {
  position: absolute;
  top: 12px;
  left: 0;

  width: 1px;
  height: max(35px, calc(72vh - var(--y)));

  background: linear-gradient(
    to bottom,
    currentColor,
    rgba(70, 190, 255, 0.2) 65%,
    transparent
  );

  opacity: 0.55;
  box-shadow: 0 0 5px currentColor;
}

/* Glowing point */

.symbol-light-point {
  position: absolute;
  top: 8px;
  left: -2px;

  width: 5px;
  height: 5px;

  border-radius: 50%;
  background: #d7f6ff;

  box-shadow:
    0 0 7px 2px currentColor,
    0 0 18px currentColor;

  animation: pointPulse 2.5s ease-in-out infinite;
  animation-delay: var(--delay);
}

/* Icon circles */

.symbol-icon {
  position: absolute;
  top: 0;
  left: 0;

  display: grid;
  place-items: center;

  width: clamp(27px, 3vw, 44px);
  height: clamp(27px, 3vw, 44px);

  border: 1px solid currentColor;
  border-radius: 50%;

  background: rgba(5, 23, 48, 0.48);

  box-shadow:
    0 0 10px rgba(0, 180, 255, 0.13),
    inset 0 0 8px rgba(0, 180, 255, 0.08);

  backdrop-filter: blur(3px);
}

.symbol-icon svg {
  width: 55%;
  height: 55%;
  stroke-width: 1.7;
  filter: drop-shadow(0 0 5px currentColor);
}

/* Brand colors */

.symbol-blue {
  color: #72cfff;
}

.symbol-green {
  color: #59b83f;
}

.symbol-orange {
  color: #f39a32;
}

.symbol-green .symbol-icon {
  box-shadow: 0 0 12px rgba(89, 184, 63, 0.2);
}

.symbol-orange .symbol-icon {
  box-shadow: 0 0 12px rgba(243, 154, 50, 0.2);
}

/* ==========================================
   FLOATING PARTICLES
   ========================================== */

.avs3d-particles {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.scene-particle {
  position: absolute;
  width: var(--size);
  height: var(--size);
  border-radius: 50%;

  animation:
    particleDrift
    calc(4s + var(--size))
    ease-in-out
    infinite alternate;

  animation-delay: var(--delay);
}

.particle-blue {
  background: #67d5ff;
  box-shadow: 0 0 8px 2px rgba(42, 174, 255, 0.7);
}

.particle-green {
  background: #59b83f;
  box-shadow: 0 0 9px 2px rgba(89, 184, 63, 0.65);
}

.particle-orange {
  background: #f39a32;
  box-shadow: 0 0 9px 2px rgba(243, 154, 50, 0.7);
}

/* ==========================================
   EDGE VIGNETTE
   ========================================== */

.avs3d-vignette {
  position: absolute;
  inset: 0;

  background: linear-gradient(
    to bottom,
    rgba(2, 10, 25, 0.1),
    transparent 45%,
    rgba(2, 10, 25, 0.16)
  );

  pointer-events: none;
}

/* ==========================================
   ANIMATIONS
   ========================================== */

@keyframes symbolFloat {
  0%,
  100% {
    translate: 0 0;
  }

  50% {
    translate: calc(var(--mouse-x) * 8px) -12px;
  }
}

@keyframes particleDrift {
  from {
    translate: 0 0;
    opacity: 0.25;
  }

  to {
    translate: 12px -22px;
    opacity: 0.95;
  }
}

@keyframes ringPulse {
  0%,
  100% {
    opacity: 0.65;
    filter: brightness(0.9);
  }

  50% {
    opacity: 1;
    filter: brightness(1.35);
  }
}

@keyframes ringRotate {
  from {
    rotate: 0deg;
  }

  to {
    rotate: 360deg;
  }
}

@keyframes corePulse {
  0%,
  100% {
    opacity: 0.45;
    scale: 0.96;
  }

  50% {
    opacity: 0.95;
    scale: 1.04;
  }
}

@keyframes pointPulse {
  0%,
  100% {
    opacity: 0.5;
    scale: 0.8;
  }

  50% {
    opacity: 1;
    scale: 1.3;
  }
}

@keyframes lightDrift {
  from {
    translate: -15px -8px;
    scale: 1;
  }

  to {
    translate: 20px 18px;
    scale: 1.12;
  }
}

@keyframes orbitGlow {
  from {
    opacity: 0.35;
  }

  to {
    opacity: 0.85;
  }
}

/* ==========================================
   TABLET
   ========================================== */

@media (max-width: 1024px) {
  .avs-home {
    height: 680px;
    min-height: 620px;
  }

  .holo-platform {
    width: 65vw;
    bottom: 13%;
  }

  .finance-symbol {
    transform: scale(0.85);
  }

  .avs3d-grid {
    background-size: 50px 50px;
  }

  .avs3d-floor {
    background-size: 46px 46px;
  }
}

/* ==========================================
   MOBILE
   ========================================== */

@media (max-width: 640px) {
  .avs-home {
    height: 760px;
    min-height: 700px;
  }

  .avs3d-scene {
    perspective: 800px;
  }

  .avs3d-light {
    width: 65vw;
    height: 65vw;
    filter: blur(75px);
  }

  .avs3d-grid {
    background-size: 40px 40px;
    opacity: 0.12;
  }

  .avs3d-floor {
    bottom: -33%;
    height: 58%;
    background-size: 38px 38px;
  }

  .holo-platform {
    width: 95vw;
    bottom: 12%;
  }

  .holo-ring-middle {
    border-width: 1px;
  }

  .holo-ring-core {
    border-width: 1px;
  }

  .holo-ticks span {
    height: 4px;
  }

  .finance-symbol {
    transform: scale(0.68);
  }

  .finance-symbol:nth-child(3n) {
    opacity: 0.45;
  }

  .symbol-beam {
    opacity: 0.35;
  }

  .avs3d-orbit-one {
    width: 330px;
    height: 120px;
    right: -35%;
  }

  .avs3d-orbit-two {
    width: 280px;
    height: 100px;
    left: -35%;
  }

  .scene-particle {
    opacity: 0.65;
  }
}

/* ==========================================
   ACCESSIBILITY: REDUCED MOTION
   ========================================== */

@media (prefers-reduced-motion: reduce) {
  .avs3d-light,
  .avs3d-orbit,
  .holo-ring,
  .holo-ticks,
  .holo-core-glow,
  .finance-symbol,
  .symbol-light-point,
  .scene-particle {
    animation: none !important;
  }
}

