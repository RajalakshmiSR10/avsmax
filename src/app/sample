    width: 250px;
    height: 100px;
    left: -30%;
  }
}

/* ==========================================
   REDUCED MOTION ACCESSIBILITY
   ========================================== */

@media (prefers-reduced-motion: reduce) {
  .avs3d-icon,
  .avs3d-glow,
  .avs3d-particle {
    animation: none !important;
  }

  .avs3d-grid {
    transform: none;
  }

  .avs3d-floor {
    transform: rotateX(68deg);
  }
}










