
/* ==========================================
   AVS MAX — DARK NAVY 3D FINANCE BACKGROUND
   Borderless Floating Icons
   Mouse Parallax + Perspective Grid
   ========================================== */

.avs3d-scene {
  --mouse-x: 0;
  --mouse-y: 0;

  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  isolation: isolate;
  pointer-events: none;
  perspective: 1100px;

  background: #071326;
}

/* Base navy background */

/* ==========================================
   AVS MAX — BRANDED NAVY BLUE BACKGROUND
   Blue + Green + Orange
   ========================================== */

.avs3d-base {
  position: absolute;
  inset: 0;
  overflow: hidden;

  background:
    /* Green ambient glow — left bottom */
    radial-gradient(
      ellipse at 8% 72%,
      rgba(83, 180, 57, 0.24) 0%,
      transparent 35%
    ),

    /* Orange ambient glow — right center */
    radial-gradient(
      ellipse at 100% 48%,
      rgba(247, 136, 9, 0.22) 0%,
      transparent 34%
    ),

    /* Bright blue light — top center */
    radial-gradient(
      ellipse at 35% 5%,
      rgba(61, 110, 194, 0.55) 0%,
      transparent 42%
    ),

    /* Soft blue glow — center */
    radial-gradient(
      ellipse at 52% 45%,
      rgba(30, 53, 107, 0.85) 0%,
      transparent 65%
    ),

    /* Main blue gradient */
    linear-gradient(
      135deg,
      #09172f 0%,
      #1E356B 48%,
      #0A1934 100%
    );
}

/* ==========================================
   GRID — BRAND BLUE
   ========================================== */

.avs3d-grid {
  opacity: 0.24;

  background-image:
    linear-gradient(
      rgba(110, 160, 230, 0.12) px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(110, 160, 230, 0.12) 1px,
      transparent 1px
    );

  background-size: 65px 65px;

  transform: translate3d(
    calc(var(--mouse-x) * -7px),
    calc(var(--mouse-y) * -7px),
    0
  );
}

/* ==========================================
   PERSPECTIVE FLOOR — BLUE WITH WARM GLOW
   ========================================== */

.avs3d-floor {
  background-image:
    linear-gradient(
      rgba(91, 147, 226, 0.24) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(91, 147, 226, 0.24) 1px,
      transparent 1px
    );

  background-size: 58px 58px;
}

/* Green orbit */
.avs3d-orbit-two {
  border-color: rgba(89, 184, 63, 0.32);
}

/* Blue orbit */
.avs3d-orbit-one {
  border-color: rgba(120, 170, 245, 0.24);
}

/* Brand colour for floating icons */
.coin-card .avs3d-icon-face,
.dollar-card .avs3d-icon-face,
.rupee-card .avs3d-icon-face,
.wallet-card .avs3d-icon-face {
  color: #F39A32;
}

.chart-card .avs3d-icon-face,
.growth-card .avs3d-icon-face,
.arrow-card .avs3d-icon-face {
  color: #59B83F;
}

.calculator-card .avs3d-icon-face,
.document-card .avs3d-icon-face,
.receipt-card .avs3d-icon-face,
.bank-card .avs3d-icon-face,
.pie-card .avs3d-icon-face {
  color: #FFFFFF;
}


/* ==========================================
   AMBIENT LIGHTING
   ========================================== */

.avs3d-glow {
  position: absolute;
  width: 38vw;
  height: 38vw;
  min-width: 240px;
  min-height: 240px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.24;

  animation: avs3d-glow-drift 12s ease-in-out infinite alternate;
}

.avs3d-glow-blue {
  top: -20%;
  left: 15%;
  background: #255eaa;
}

.avs3d-glow-green {
  top: 20%;
  right: -18%;
  background: #278b68;
  opacity: 0.12;
  animation-delay: -4s;
}

.avs3d-glow-orange {
  bottom: -35%;
  left: 25%;
  background: #d77b2e;
  opacity: 0.12;
  animation-delay: -7s;
}

/* ==========================================
   TECHNICAL BACKGROUND GRID
   ========================================== */

.avs3d-grid {
  position: absolute;
  inset: 0;
  opacity: 0.2;

  background-image:
    linear-gradient(
      rgba(110, 158, 214, 0.09) 3px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(110, 158, 214, 0.09) 1px,
      transparent 1px
    );

  background-size: 65px 65px;

  transform: translate3d(
    calc(var(--mouse-x) * -7px),
    calc(var(--mouse-y) * -7px),
    0
  );
}

/* ==========================================
   3D PERSPECTIVE FLOOR
   ========================================== */

.avs3d-floor {
  position: absolute;
  left: -20%;
  bottom: -45%;
  width: 140%;
  height: 75%;

  transform:
    rotateX(68deg)
    translate3d(
      calc(var(--mouse-x) * -9px),
      calc(var(--mouse-y) * -5px),
      -80px
    );

  transform-origin: center top;

  background-image:
    linear-gradient(
      rgba(74, 135, 204, 0.19) 3px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(74, 135, 204, 0.19) 1px,
      transparent 1px
    );

  background-size: 58px 58px;

  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent,
    black 35%,
    transparent 95%
  );

  mask-image: linear-gradient(
    to bottom,
    transparent,
    black 35%,
    transparent 95%
  );
}

/* ==========================================
   DECORATIVE ORBIT LINES
   ========================================== */

.avs3d-orbit {
  position: absolute;
  border: 1px solid rgba(166, 183, 202, 0.16);
  border-radius: 50%;
  transform-style: preserve-3d;
}

.avs3d-orbit-one {
  width: 550px;
  height: 210px;
  top: 12%;
  right: -8%;

  transform:
    rotate(-27deg)
    rotateY(calc(var(--mouse-x) * 4deg));

  box-shadow: 0 0 30px rgba(49, 117, 205, 0.04);
}

.avs3d-orbit-two {
  width: 400px;
  height: 155px;
  left: -7%;
  bottom: 15%;

  border-color: rgba(89, 184, 63, 0.14);

  transform:
    rotate(25deg)
    rotateY(calc(var(--mouse-x) * -3deg));
}

/* ==========================================
   FLOATING FINANCE ICON LAYER
   No cards, no square borders, no backgrounds
   ========================================== */

.avs3d-icon-layer {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
}

/* Transparent icon container */
.avs3d-icon {
  --depth: 1;
  --index: 0;

  position: absolute;

  display: grid;
  place-items: center;

  width: 88px;
  height: 88px;

  /* Remove the original card appearance */
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;

  transform-style: preserve-3d;
  will-change: transform;

  animation:
    avs3d-float
    calc(6s + var(--index) * 0.45s)
    ease-in-out
    infinite;

  animation-delay: calc(var(--index) * -0.7s);

  transition:
    opacity 300ms ease,
    filter 300ms ease;
}

/* Remove inner decorative square */
.avs3d-icon::before {
  content: none;
}

/* Icon face */
.avs3d-icon-face {
  display: grid;
  place-items: center;

  width: 100%;
  height: 100%;

  transform: translateZ(17px);
}

/* Lucide icon styling */
.avs3d-icon-face svg {
  display: block;

  width: 37px;
  height: 37px;

  stroke-width: 1.6;
  fill: none;

  filter: drop-shadow(0 0 8px currentColor);

  transition:
    transform 300ms ease,
    filter 300ms ease;
}

/* ==========================================
   ICON COLOURS
   ========================================== */

/* Gold finance icons */
.coin-card .avs3d-icon-face,
.dollar-card .avs3d-icon-face,
.rupee-card .avs3d-icon-face,
.wallet-card .avs3d-icon-face {
  color: #f3bd62;
}

/* Light blue document icons */
.calculator-card .avs3d-icon-face,
.document-card .avs3d-icon-face,
.receipt-card .avs3d-icon-face {
  color: #a9c9f6;
}

/* Green growth icons */
.chart-card .avs3d-icon-face,
