
/* ==========================================
   AVS MAX — DARK NAVY 3D FINANCE BACKGROUND
   Borderless Floating Icons
   Mouse Parallax + Perspective Grid
   ========================================== */

.avs3d-scene {
  --mouse-x: 0;
  --mouse-y: 0;

  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  isolation: isolate;
  pointer-events: none;
  perspective: 1100px;

  background: #071326;
}

/* Base navy background */

/* ==========================================
   AVS MAX — BRANDED NAVY BLUE BACKGROUND
   Blue + Green + Orange
   ========================================== */

.avs3d-base {
  position: absolute;
  inset: 0;
  overflow: hidden;

  background:
    /* Green ambient glow — left bottom */
    radial-gradient(
      ellipse at 8% 72%,
      rgba(83, 180, 57, 0.24) 0%,
      transparent 35%
    ),

    /* Orange ambient glow — right center */
    radial-gradient(
      ellipse at 100% 48%,
      rgba(247, 136, 9, 0.22) 0%,
      transparent 34%
    ),

    /* Bright blue light — top center */
    radial-gradient(
      ellipse at 35% 5%,
      rgba(61, 110, 194, 0.55) 0%,
      transparent 42%
    ),

    /* Soft blue glow — center */
    radial-gradient(
      ellipse at 52% 45%,
      rgba(30, 53, 107, 0.85) 0%,
      transparent 65%
    ),

    /* Main blue gradient */
    linear-gradient(
      135deg,
      #09172f 0%,
      #1E356B 48%,
      #0A1934 100%
    );
}

/* ==========================================
   GRID — BRAND BLUE
   ========================================== */

.avs3d-grid {
  opacity: 0.24;

  background-image:
    linear-gradient(
      rgba(110, 160, 230, 0.12) px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(110, 160, 230, 0.12) 1px,
      transparent 1px
    );

  background-size: 65px 65px;

  transform: translate3d(
    calc(var(--mouse-x) * -7px),
    calc(var(--mouse-y) * -7px),
    0
  );
}

/* ==========================================
   PERSPECTIVE FLOOR — BLUE WITH WARM GLOW
   ========================================== */

.avs3d-floor {
  background-image:
    linear-gradient(
      rgba(91, 147, 226, 0.24) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(91, 147, 226, 0.24) 1px,
      transparent 1px
    );

  background-size: 58px 58px;
}

/* Green orbit */
.avs3d-orbit-two {
  border-color: rgba(89, 184, 63, 0.32);
}

/* Blue orbit */
.avs3d-orbit-one {
  border-color: rgba(120, 170, 245, 0.24);
}

/* Brand colour for floating icons */
