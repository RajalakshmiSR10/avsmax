  .arrow-card,
  .pie-card {
    opacity: 0.65;
  }

  .coin-card {
    left: 8%;
  }

  .chart-card {
    right: 8%;
  }

  .growth-card {
    left: 23%;
  }

  .avs3d-orbit-one {
