    top: 57%;
    right: 4%;
  }

  .growth-card {
    top: 75%;
    left: 19%;
  }

  .dollar-card {
    top: 46%;
    right: 23%;
  }

  .bank-card {
    top: 10%;
    right: 32%;
  }

  .receipt-card {
    bottom: 10%;
    right: 30%;
  }

  .wallet-card {
    top: 65%;
    left: 4%;
  }

  .pie-card {
    top: 37%;
    right: 4%;
  }

  .rupee-card {
    top: 78%;
    right: 5%;
  }

  .arrow-card {
    top: 10%;
    left: 34%;
  }

  /* Smaller orbit lines */
  .avs3d-orbit-one {
    width: 300px;
    height: 120px;
    right: -32%;
  }

  .avs3d-orbit-two {
    width: 250px;
    height: 100px;
    left: -30%;
  }
}

/* ==========================================
   REDUCED MOTION ACCESSIBILITY
   ========================================== */

@media (prefers-reduced-motion: reduce) {
  .avs3d-icon,
  .avs3d-glow,
  .avs3d-particle {
    animation: none !important;
  }

  .avs3d-grid {
    transform: none;
  }

  .avs3d-floor {
    transform: rotateX(68deg);
  }
}



