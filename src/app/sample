  }
}

/* ==========================================
   MOBILE RESPONSIVE
   ========================================== */

@media (max-width: 640px) {
  .avs3d-scene {
    perspective: 800px;
  }

  .avs3d-grid {
    background-size: 42px 42px;
  }

  .avs3d-floor {
    bottom: -35%;
    height: 60%;
    background-size: 42px 42px;
  }

  .avs3d-glow {
    filter: blur(65px);
  }

  .avs3d-icon {
    width: 55px;
    height: 55px;

    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;

    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .avs3d-icon-face svg {
    width: 26px;
    height: 26px;
  }

  /* Mobile icon positions */
  .coin-card {
