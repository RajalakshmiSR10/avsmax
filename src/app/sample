    );
}

/* ==========================================
   FLOATING ANIMATION + MOUSE PARALLAX
   ========================================== */

@keyframes avs3d-float {
  0%,
  100% {
    transform:
      translate3d(
        calc(var(--mouse-x) * var(--depth) * -15px),
        calc(var(--mouse-y) * var(--depth) * -12px),
        calc(var(--depth) * 12px)
      )
      rotateX(0deg)
      rotateY(0deg)
      rotateZ(0deg);
  }

  50% {
    transform:
      translate3d(
        calc(var(--mouse-x) * var(--depth) * -15px),
        calc(
          var(--mouse-y) * var(--depth) * -12px - 15px
        ),
        calc(var(--depth) * 24px)
      )
      rotateX(5deg)
      rotateY(-6deg)
      rotateZ(2deg);
  }
}

/* Ambient glow movement */
@keyframes avs3d-glow-drift {
  from {
    transform: translate3d(-12px, -8px, 0) scale(1);
  }

  to {
    transform: translate3d(20px, 15px, 0) scale(1.1);
  }
}

/* Particle movement */
@keyframes avs3d-particle-float {
  from {
    transform: translate3d(0, 0, 0);
    opacity: 0.3;
  }

  to {
    transform: translate3d(12px, -22px, 0);
    opacity: 0.9;
  }
}

