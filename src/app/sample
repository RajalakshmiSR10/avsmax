/* ==========================================
   OPTIONAL FLOATING PARTICLES
   ========================================== */

.avs3d-particle {
  position: absolute;

  width: 5px;
  height: 5px;

  border-radius: 50%;
  background: #a5c9ff;

  box-shadow: 0 0 16px 3px rgba(85, 151, 242, 0.3);

  animation:
    avs3d-particle-float
    7s ease-in-out
    infinite alternate;
}

.particle-one {
  top: 30%;
  left: 30%;
}

.particle-two {
